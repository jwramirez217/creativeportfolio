/* Jose W. Ramirez creative portfolio — deployable static website */
:root{--bg:#101418;--bg2:#151d20;--card:#1d2729;--panel:#202d2f;--cream:#f9f2e4;--muted:#b5c7c2;--gold:#eebd7d;--mint:#a9e5d3;--line:#ffffff21;--serif:Georgia,'Times New Roman',serif}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--cream);font-family:Inter,ui-sans-serif,system-ui,'Segoe UI',Arial,sans-serif;font-size:16px;line-height:1.55}a{color:inherit}button{font:inherit}button,a{ -webkit-tap-highlight-color:transparent }a:focus-visible,button:focus-visible{outline:3px solid var(--gold);outline-offset:5px}img{max-width:100%;display:block}::selection{background:#d1b08b;color:#102024}
.outer{max-width:1240px;margin:auto;padding:0 36px}.topbar{display:flex;align-items:center;justify-content:space-between;gap:22px;padding-top:26px;padding-bottom:24px;border-bottom:1px solid var(--line)}.mark{text-decoration:none;font-weight:850;letter-spacing:.09em;font-size:15px;display:flex;align-items:center;gap:12px}.markicon{width:35px;height:35px;border:2px solid var(--gold);display:grid;place-items:center;color:var(--gold);font-family:var(--serif);font-weight:700;font-size:24px;border-radius:50%}.nav{display:flex;gap:25px}.nav a{text-decoration:none;color:var(--muted);font-size:13px;font-weight:720;letter-spacing:.1em;text-transform:uppercase}.nav a:hover{color:var(--cream)}
.hero{min-height:550px;display:grid;grid-template-columns:1.14fr .86fr;gap:55px;align-items:center;padding-top:78px;padding-bottom:94px}.eyebrow{text-transform:uppercase;letter-spacing:.24em;font-weight:760;font-size:12px;color:var(--mint);margin:0 0 20px}.hero h1{font:normal clamp(58px,7.5vw,104px)/.98 var(--serif);letter-spacing:-.058em;margin:0}.hero h1 em{display:block;font-weight:400;color:var(--gold);letter-spacing:-.06em}.hero p.intro{font-size:18px;max-width:575px;color:#d7ded8;margin:25px 0 31px}.actions{display:flex;flex-wrap:wrap;gap:10px}.btn{border:1px solid #d9caa7;border-radius:999px;padding:12px 21px;background:var(--cream);color:#142329;font-weight:760;text-decoration:none;cursor:pointer;display:inline-flex;gap:9px;align-items:center;justify-content:center;transition:transform .18s,background .18s}.btn:hover{transform:translateY(-2px);background:#fff}.btn.ghost{background:transparent;color:var(--cream);border-color:#ffffff6a}.btn.ghost:hover{background:#ffffff19}.btn.sm{padding:9px 15px;font-size:13px}.hero-art{min-height:450px;position:relative;display:flex;align-items:center;justify-content:center}.hero-frame{position:relative;width:60%;min-width:225px;height:430px;transform:rotate(7deg);border:10px solid #f3e9d0;border-radius:5px;overflow:hidden;box-shadow:20px 22px 60px #0009}.hero-frame img{width:100%;height:100%;object-fit:cover;object-position:center 55%}.hero-label{position:absolute;left:2%;bottom:9%;max-width:190px;padding:19px;background:#eabf85;color:#152025;transform:rotate(-7deg);box-shadow:0 15px 40px #0006}.hero-label span{display:block;text-transform:uppercase;font-size:10px;font-weight:800;letter-spacing:.16em}.hero-label b{display:block;font:28px/1.1 var(--serif);margin-top:7px}.hero-orbit{position:absolute;inset:32px 5% 35px 8%;border:1px solid #bce6cf40;border-radius:50%;transform:rotate(-17deg);pointer-events:none}
.section{padding-bottom:100px}.sect-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:28px;padding-bottom:19px;border-bottom:1px solid var(--line)}.sect-head h2{font:normal clamp(34px,4.4vw,53px)/1.07 var(--serif);margin:0;letter-spacing:-.035em}.sect-head p{margin:0;color:var(--muted);font-size:13px;max-width:355px;text-align:right}.cards{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:20px}.project{grid-column:span 2;display:flex;flex-direction:column;min-width:0;border:1px solid var(--line);border-radius:13px;overflow:hidden;background:var(--card);transition:transform .2s,border-color .2s}.project:hover{transform:translateY(-4px);border-color:#e5c58c77}.project.featured{grid-column:span 3}.cover{aspect-ratio:1.42;position:relative;overflow:hidden;background:#233437}.cover>img{width:100%;height:100%;object-fit:cover;transition:transform .3s}.project:hover .cover>img{transform:scale(1.045)}.cover .num{position:absolute;top:14px;left:14px;font-size:10px;letter-spacing:.13em;font-weight:800;color:#152121;background:#f4e8d5;border-radius:30px;padding:7px 10px}.cover .kind{position:absolute;right:14px;bottom:14px;font-size:10px;color:#fff;background:#051619c9;border:1px solid #ffffff32;padding:6px 9px;border-radius:20px}.project-body{padding:23px 24px 24px;display:flex;flex-direction:column;flex:1}.project-body h3{font:normal 30px/1.18 var(--serif);letter-spacing:-.025em;margin:0}.sub{color:var(--gold);font-size:12px;text-transform:uppercase;letter-spacing:.15em;font-weight:800;margin:12px 0}.desc{font-size:14px;color:#c8d5d0;margin:0 0 25px;flex:1}.project-actions{display:flex;gap:11px;flex-wrap:wrap}.project-actions a,.project-actions button{font-weight:760;font-size:13px;border:0;border-bottom:1px solid var(--gold);padding:0 0 4px;cursor:pointer;background:none;color:var(--cream);text-decoration:none}.project-actions a:hover,.project-actions button:hover{color:var(--gold)}.project-actions .muted{color:var(--muted);border-bottom-color:#ffffff44}
.statement{padding:35px 0 90px;display:grid;grid-template-columns:1fr 1.5fr;gap:50px;border-top:1px solid var(--line)}.statement h2{font:normal 41px var(--serif);margin:4px 0}.statement p{margin-top:0;color:#ccd9d5;font-size:17px}.statement .pillrow{display:flex;flex-wrap:wrap;gap:9px}.pill{border:1px solid #ffffff44;border-radius:999px;color:var(--mint);font-size:12px;padding:8px 12px;letter-spacing:.035em}.footer{background:#0a1012;border-top:1px solid var(--line)}.footer-inner{display:flex;align-items:center;justify-content:space-between;padding-top:24px;padding-bottom:30px;gap:25px;font-size:13px;color:#9eb4aa}.footer-inner strong{font-weight:780;color:var(--cream)}
dialog{border:0;max-width:none;max-height:none;inset:0;width:100vw;height:100dvh;padding:0;background:#071015;color:var(--cream);overflow:auto}dialog::backdrop{background:#000e}.viewer-inner{max-width:1140px;margin:auto;padding:26px 24px 70px;text-align:center}.viewer-bar{display:flex;align-items:center;justify-content:space-between;gap:10px;max-width:860px;margin:0 auto 24px}.viewer-bar h2{font:normal 27px var(--serif);margin:0;text-align:left}.viewer-bar button{cursor:pointer;background:#ffffff16;border:1px solid #ffffff69;color:white;border-radius:50px;padding:9px 15px}.flip-stage{width:min(100%,620px);aspect-ratio:2/3;margin:auto;perspective:1500px;position:relative}.flip-inner{width:100%;height:100%;position:relative;transform-style:preserve-3d;transition:transform .95s cubic-bezier(.22,.82,.19,1)}.flip-inner.flipped{transform:rotateY(180deg)}.flip-face{backface-visibility:hidden;position:absolute;inset:0;box-shadow:0 20px 50px #000b;border:1px solid #ffffff44;background:#090e0e}.flip-face.back{transform:rotateY(180deg)}.flip-face img{width:100%;height:100%;object-fit:contain}.touch-hotspot{position:absolute;right:0.5%;bottom:0%;height:19%;width:12%;border:0;background:transparent;cursor:pointer;border-radius:8px}.touch-hotspot:hover,.touch-hotspot:focus-visible{background:#ffffdd2a;outline:2px dotted var(--gold)}.viewer-instructions{font-size:13px;letter-spacing:.02em;color:var(--muted);margin:22px auto 10px}.viewer-actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin-top:15px}.viewer-count{margin:14px 0;color:var(--gold);font-size:12px;letter-spacing:.15em;text-transform:uppercase}.viewer-note{max-width:570px;margin:17px auto;color:#b3c3ba;font-size:13px}.hidden{display:none!important}
@media(max-width:960px){.hero{grid-template-columns:1fr 0.8fr;gap:20px}.cards{gap:14px}.project.featured{grid-column:span 3}.project{grid-column:span 3}.hero h1{font-size:70px}}@media(max-width:700px){.outer{padding-left:20px;padding-right:20px}.topbar{padding-top:18px;padding-bottom:19px}.mark{font-size:12px}.nav{gap:15px}.nav a{font-size:10px}.hero{grid-template-columns:1fr;padding-top:52px;padding-bottom:58px;min-height:auto}.hero h1{font-size:clamp(57px,12vw,76px)}.hero p.intro{font-size:16px}.hero-art{min-height:325px;margin-top:10px}.hero-frame{height:305px;width:48%;min-width:200px}.hero-label{bottom:5%;left:5%}.section{padding-bottom:60px}.sect-head{display:block}.sect-head p{text-align:left;margin-top:12px}.project,.project.featured{grid-column:span 6}.project-body h3{font-size:29px}.statement{grid-template-columns:1fr;gap:15px;padding-bottom:60px}.statement h2{font-size:36px}.footer-inner{display:block}.footer-inner span{display:block;margin-top:5px}.viewer-inner{padding:16px 12px 50px}.viewer-bar h2{font-size:21px}.flip-stage{width:min(96vw,520px)}.viewer-instructions{margin-top:17px}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;animation:none!important;transition:none!important}}

.cover-hit{position:absolute;inset:0;width:100%;height:100%;z-index:2;display:block;background:transparent;border:0;cursor:pointer}.cover .num,.cover .kind{z-index:3;pointer-events:none}.cover:focus-within{outline:3px solid var(--gold);outline-offset:-3px}

